# Base de datos (Neon · Vercel → Storage → Neon → Connect).
# En local: `vercel env pull .env.local`
DATABASE_URL=

# URL pública del sitio, para los enlaces que se mandan por WhatsApp.
# En producción Vercel la deduce sola; esto es para local o dominio propio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
